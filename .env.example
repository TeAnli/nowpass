# Copy to .env. Keep API keys on the server; never put them in VITE_* variables.
INTERVIEW_BASE_URL=https://api.deepseek.com
INTERVIEW_MODEL=deepseek-flash
INTERVIEW_API_KEY=

# 阿里云智能语音交互（TTS）。关闭时前端回退浏览器语音。
TTS_ENABLED=false
ALIYUN_TTS_ACCESS_KEY_ID=
ALIYUN_TTS_ACCESS_KEY_SECRET=
ALIYUN_TTS_APP_KEY=
ALIYUN_TTS_VOICE=zhixiaoxia
ALIYUN_TTS_REGION=cn-shanghai
